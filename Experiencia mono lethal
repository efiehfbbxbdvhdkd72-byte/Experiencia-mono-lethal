              return 
          end
          
          local rootPart = character.HumanoidRootPart
          local humanoid = character:FindFirstChildOfClass("Humanoid")
          
          if flying then
              flyButton.Text = "Fly: ON"
              flyButton.BackgroundColor3 = Color3.fromRGB(0, 170, 127)
              
              if humanoid then humanoid.PlatformStand = true end
              
              bg = Instance.new("BodyGyro")
              bg.P = 9e4
              bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
              bg.CFrame = rootPart.CFrame
              bg.Parent = rootPart
              
              bv = Instance.new("BodyVelocity")
              bv.Velocity = Vector3.new(0, 0, 0)
              bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
              bv.Parent = rootPart
              
              task.spawn(function()
                  while flying and character and rootPart.Parent and humanoid do
                      local camera = workspace.CurrentCamera
                      local moveDirection = Vector3.new(0, 0, 0)
                      
                      if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                          moveDirection = moveDirection + camera.CFrame.LookVector
                      end
                      if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                          moveDirection = moveDirection - camera.CFrame.LookVector
                      end
                      if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                          moveDirection = moveDirection - camera.CFrame.RightVector
                      end
                      if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                          moveDirection = moveDirection + camera.CFrame.RightVector
                      end
                      
                      if controls then
                          local moveVector = controls:GetMoveVector()
                          if moveVector.Magnitude > 0 then
                              local camCF = camera.CFrame
                              local cameraFlatLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z).Unit
                              local cameraFlatRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit
                              
                              moveDirection = (cameraFlatLook * -moveVector.Z) + (cameraFlatRight * moveVector.X)
                          end
                      end
                      
                      local verticalVal = 0
                      if movingUp then verticalVal = 1 end
                      if movingDown then verticalVal = -1 end
                      
                      bg.CFrame = camera.CFrame
                      bv.Velocity = (moveDirection * speed) + Vector3.new(0, verticalVal * speed, 0)
                      RunService.RenderStepped:Wait()
                  end
              end)
          else
              flyButton.Text = "Fly: OFF"
              flyButton.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
              movingUp = false
              movingDown = false
              
              if humanoid then humanoid.PlatformStand = false end
              if bg then bg:Destroy() end
              if bv then bv:Destroy() end
          end
      end

