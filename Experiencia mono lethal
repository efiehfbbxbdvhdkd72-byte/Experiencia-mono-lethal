	if not (obj:IsA("BasePart") or obj:IsA("Model")) then return false end
	if obj:FindFirstChildOfClass("Humanoid") then return false end
	if obj == player.Character or (player.Character and obj:IsDescendantOf(player.Character)) then return false end

	local textToSearch = string.lower(obj.Name)
	local prompt = obj:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChild("ProximityPrompt", true)
	if prompt then
		textToSearch = textToSearch .. " " .. string.lower(prompt.ObjectText) .. " " .. string.lower(prompt.ActionText)
	end

	for _, kw in ipairs(itemKeywords) do
		if string.find(textToSearch, kw, 1, true) then
			return true
		end
	end
	return false
end

local function trackInstance(inst)
	if inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") then
		local isPlayer = Players:GetPlayerFromCharacter(inst) ~= nil
		if not isPlayer then 
			npcCache[inst] = true 
		end
	elseif isItemMatch(inst) then
		itemCache[inst] = true
	end
end

local function untrackInstance(inst)
	npcCache[inst] = nil
	itemCache[inst] = nil
	if espObjects[inst] then
		if espObjects[inst].hl then espObjects[inst].hl:Destroy() end
		if espObjects[inst].bb then espObjects[inst].bb:Destroy() end
		espObjects[inst] = nil
	end
end

-- Indexación inicial por eventos
for _, desc in ipairs(Workspace:GetDescendants()) do
	trackInstance(desc)
end

Workspace.DescendantAdded:Connect(trackInstance)
Workspace.DescendantRemoving:Connect(untrackInstance)

